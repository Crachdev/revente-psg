rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Revente PSG : uniquement Rachid et Sylvain.
    function autorise() {
      return request.auth != null
        && request.auth.token.email in [
          'rachid@psg-revente.fr',
          'sylvain@psg-revente.fr'
        ];
    }

    match /revente_matches/{doc} { allow read, write: if autorise(); }
    match /revente_config/{doc}  { allow read, write: if autorise(); }
  }
}
